{
  "name": "autocode",
  "version": "0.2.0",
  "description": "A minimal, fast, multi-provider coding agent for the terminal",
  "type": "module",
  "bin": {
    "autocode": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
